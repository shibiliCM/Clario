# ============================================
# CLARIO BACKEND CONFIGURATION
# ============================================

# Google Gemini API key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5

# Vector Store Path
VECTOR_STORE_PATH=./vector_store

# Model Selection
EMBED_MODEL=gemini-embedding-001
LLM_MODEL=gemini-2.5-flash

# Maximum upload file size in bytes (default 30MB)
MAX_FILE_SIZE_BYTES=31457280

# Server Port (auto-assigned on Render/Railway via $PORT)
PORT=8000
