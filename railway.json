{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "rag-chatbot-free-tier/rag-chatbot/Dockerfile"
  },
  "deploy": {
    "startCommand": "uvicorn rag_chatbot:app --host 0.0.0.0 --port $PORT",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
